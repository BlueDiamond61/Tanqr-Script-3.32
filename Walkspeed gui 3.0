-- Cute WalkSpeed GUI - Improved
-- Mobile + PC Support
-- Key System + Settings + Smooth Speed

local KEY = "WC$552"

local DEFAULT_SPEED = 16
local MAX_SAFE_SPEED = 120

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- Prevent duplicate GUI instances
local oldGui = playerGui:FindFirstChild("CuteWSGui")

if oldGui then
    oldGui:Destroy()
end

-- State
local humanoid
local keyAccepted = false

local antiFling = true
local softLimit = true

local currentTargetSpeed = DEFAULT_SPEED
local smoothingFactor = 8

local guiOpen = true

--------------------------------------------------
-- HUMANOID
--------------------------------------------------

local function getHumanoid(character)
    character = character or player.Character

    if not character then
        character = player.CharacterAdded:Wait()
    end

    return character:WaitForChild("Humanoid")
end

humanoid = getHumanoid()

player.CharacterAdded:Connect(function(character)

    humanoid = character:WaitForChild("Humanoid")

    task.wait(0.15)

    if keyAccepted then
        humanoid.WalkSpeed = DEFAULT_SPEED
    end
end)

--------------------------------------------------
-- UI HELPERS
--------------------------------------------------

local function makeCorner(parent, radius)

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, radius or 8)
    corner.Parent = parent

    return corner
end

local function makeStroke(parent, color, transparency, thickness)

    local stroke = Instance.new("UIStroke")
    stroke.Color = color or Color3.fromRGB(150, 120, 255)
    stroke.Transparency = transparency or 0.35
    stroke.Thickness = thickness or 1
    stroke.Parent = parent

    return stroke
end

local function tween(instance, properties, time, style, direction)

    local info = TweenInfo.new(
        time or 0.25,
        style or Enum.EasingStyle.Sine,
        direction or Enum.EasingDirection.Out
    )

    TweenService:Create(instance, info, properties):Play()
end

--------------------------------------------------
-- BUTTON CREATOR
--------------------------------------------------

local function createButton(parent, posY, text, backgroundColor)

    local button = Instance.new("TextButton")

    button.Parent = parent
    button.Size = UDim2.new(1, -40, 0, 34)
    button.Position = UDim2.new(0, 20, 0, posY)

    button.BackgroundColor3 =
        backgroundColor or Color3.fromRGB(166, 134, 255)

    button.BorderSizePixel = 0

    button.Text = text
    button.Font = Enum.Font.GothamSemibold
    button.TextScaled = true
    button.TextColor3 = Color3.fromRGB(245, 244, 250)

    button.AutoButtonColor = false

    makeCorner(button, 9)
    makeStroke(
        button,
        Color3.fromRGB(190, 165, 255),
        0.65,
        1
    )

    local originalColor =
        backgroundColor or Color3.fromRGB(166, 134, 255)

    local hoverColor =
        Color3.fromRGB(130, 98, 235)

    button.MouseEnter:Connect(function()

        tween(
            button,
            {
                BackgroundColor3 = hoverColor
            },
            0.12
        )
    end)

    button.MouseLeave:Connect(function()

        tween(
            button,
            {
                BackgroundColor3 = originalColor
            },
            0.12
        )
    end)

    button.Activated:Connect(function()

        tween(
            button,
            {
                Size = UDim2.new(1, -44, 0, 32)
            },
            0.07
        )

        task.delay(0.07, function()

            if button.Parent then

                tween(
                    button,
                    {
                        Size = UDim2.new(1, -40, 0, 34)
                    },
                    0.1
                )
            end
        end)
    end)

    return button
end

