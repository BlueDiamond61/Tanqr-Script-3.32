    BackgroundLight = Color3.fromRGB(61, 48, 94),

    Input = Color3.fromRGB(34, 29, 51),

    Primary = Color3.fromRGB(157, 119, 255),
    PrimaryLight = Color3.fromRGB(181, 149, 255),
    PrimaryDark = Color3.fromRGB(108, 76, 192),

    Text = Color3.fromRGB(247, 245, 252),
    SubText = Color3.fromRGB(185, 176, 210),

    Success = Color3.fromRGB(105, 235, 145),
    Warning = Color3.fromRGB(255, 190, 90),
