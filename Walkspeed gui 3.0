local notificationHolder =
    Instance.new("Frame")

notificationHolder.Name =
    "Notifications"

notificationHolder.Size =
    UDim2.new(0, 300, 0, 300)

notificationHolder.Position =
    UDim2.new(1, -315, 0, 55)

notificationHolder.BackgroundTransparency = 1

notificationHolder.ZIndex = 50

notificationHolder.Parent = gui

local notificationLayout =
    Instance.new("UIListLayout")

notificationLayout.Padding =
    UDim.new(0, 7)

notificationLayout.HorizontalAlignment =
    Enum.HorizontalAlignment.Right

notificationLayout.VerticalAlignment =
    Enum.VerticalAlignment.Top

notificationLayout.Parent =
    notificationHolder

local function notify(
    message,
    color,
    duration
)

    local notification =
        Instance.new("Frame")

    notification.Size =
        UDim2.new(0, 280, 0, 45)

    notification.BackgroundColor3 =
        COLORS.Background

    notification.BackgroundTransparency = 0.03

    notification.BorderSizePixel = 0

    notification.ZIndex = 51

    notification.Parent =
        notificationHolder

    corner(notification, 10)

    stroke(
        notification,
        color or COLORS.Primary,
        0.25,
        1.2
    )

    local label =
        Instance.new("TextLabel")

    label.Size =
        UDim2.new(1, -24, 1, 0)

    label.Position =
        UDim2.new(0, 12, 0, 0)

    label.BackgroundTransparency = 1

    label.Text = message

    label.Font =
        Enum.Font.GothamSemibold

    label.TextScaled = true

    label.TextColor3 =
        COLORS.Text

    label.ZIndex = 52

    label.Parent = notification

    notification.Position =
        UDim2.new(1, 20, 0, 0)

    tween(
        notification,
        {
            Position =
                UDim2.new(0, 0, 0, 0)
        },
        0.3
    )

    task.delay(
        duration or 2.5,
        function()

            if notification.Parent then

                tween(
                    notification,
                    {
                        Position =
                            UDim2.new(
                                1,
                                20,
                                0,
                                0
                            ),
                        BackgroundTransparency = 1
                    },
                    0.25
                )

                task.wait(0.27)

                notification:Destroy()

            end
        end
    )
end

