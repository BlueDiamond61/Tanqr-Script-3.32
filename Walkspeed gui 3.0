if existing then
    existing:Destroy()
end

--------------------------------------------------
-- STATE
--------------------------------------------------

local humanoid = nil
local rootPart = nil

local unlocked = false
local guiOpen = true

local currentTargetSpeed = DEFAULT_SPEED
local previousTargetSpeed = DEFAULT_SPEED

local antiFling = true
local softLimit = true
local smoothSpeed = true

local selectedPreset = "Normal"

local connections = {}

--------------------------------------------------
-- CONNECTION MANAGEMENT
--------------------------------------------------

local function connect(signal, callback)

    local connection = signal:Connect(callback)

    table.insert(connections, connection)

    return connection
end

local function cleanup()

    for _, connection in ipairs(connections) do

        if connection and connection.Connected then
            connection:Disconnect()
        end

    end

    table.clear(connections)
end

--------------------------------------------------
-- HUMANOID MANAGEMENT
--------------------------------------------------

local function updateCharacter(character)

    humanoid = nil
    rootPart = nil

    if not character then
        return
    end

    humanoid = character:WaitForChild("Humanoid", 10)
    rootPart = character:WaitForChild("HumanoidRootPart", 10)

    if unlocked and humanoid then
        task.wait(0.15)

        if humanoid and humanoid.Parent then
            humanoid.WalkSpeed = DEFAULT_SPEED
        end
    end
end

updateCharacter(player.Character)

connect(
    player.CharacterAdded,
    function(character)

        updateCharacter(character)

        task.wait(0.2)

        if unlocked and humanoid then
            humanoid.WalkSpeed = currentTargetSpeed
        end
    end
)

