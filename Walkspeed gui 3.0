--------------------------------------------------
-- RESET SETTINGS
--------------------------------------------------

connect(
    resetButton.Activated,
    function()

        antiFling = true
        softLimit = true
        smoothSpeed = true

        currentTargetSpeed =
            DEFAULT_SPEED

        previousTargetSpeed =
            DEFAULT_SPEED

        selectedPreset =
            "Normal"

        antiFlingButton.Text =
            "Anti-Fling: ON"

        softLimitButton.Text =
            "Soft Limit: ON"

        smoothButton.Text =
            "Smooth Speed: ON"

        speedInput.Text =
            tostring(DEFAULT_SPEED)

        setSliderSpeed(DEFAULT_SPEED)

        if humanoid then
            humanoid.WalkSpeed =
                DEFAULT_SPEED
        end

        setStatus(
            "Settings reset",
            COLORS.Success
        )

        notify(
            "All settings reset.",
            COLORS.Success
        )
    end
)

--------------------------------------------------
-- FLOATING BUTTON
--------------------------------------------------

connect(
    toggleButton.Activated,
    function()

        if guiOpen then

            guiOpen = false

            closePanels()

        else

            guiOpen = true

            if unlocked then
                showMain()
            else
                showKey()
            end

        end
    end
)

--------------------------------------------------
-- ANTI-FLING
--------------------------------------------------

local lastFlingTime = 0

local function handleAntiFling()

    if not antiFling then
        return
    end

    if not rootPart or not humanoid then
        return
    end

    local velocity =
        rootPart.AssemblyLinearVelocity

    local magnitude =
        velocity.Magnitude

    if magnitude > 200 then

        local now =
            os.clock()

        if now - lastFlingTime > 0.25 then

            lastFlingTime = now

            humanoid.WalkSpeed =
                math.min(
                    humanoid.WalkSpeed,
                    DEFAULT_SPEED
                )

        end
    end
end

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

connect(
    RunService.Heartbeat,
    function(dt)

        if not unlocked then
            return
        end

        if not humanoid then
            return
        end

        if humanoid.Health <= 0 then
            return
        end

        --------------------------------------------------
        -- TARGET SPEED
        --------------------------------------------------

        local target =
            currentTargetSpeed

        if softLimit then

            target =
                math.clamp(
                    target,
                    MIN_SPEED,
                    MAX_SPEED
                )

        end

        --------------------------------------------------
        -- SPEED APPLICATION
        --------------------------------------------------

        if smoothSpeed then

            local current =
                humanoid.WalkSpeed

            local difference =
                target - current

            local alpha =
                math.clamp(
                    dt * SMOOTHING,
                    0,
                    1
                )

            humanoid.WalkSpeed =
                current +
                (difference * alpha)

        else

            humanoid.WalkSpeed =
                target

        end

        --------------------------------------------------
        -- ANTI FLING
        --------------------------------------------------

        handleAntiFling()

        --------------------------------------------------
        -- DISPLAY
        --------------------------------------------------

        if mainFrame.Visible then
            updateDisplay()
        end
    end
)

--------------------------------------------------
-- INITIAL STATE
--------------------------------------------------

keyFrame.Visible = true
mainFrame.Visible = false
settingsFrame.Visible = false

speedInput.Text =
    tostring(DEFAULT_SPEED)

setSliderSpeed(
    DEFAULT_SPEED
)

setStatus(
    "Ready",
    COLORS.Success
)

