notificationLayout.VerticalAlignment =
    Enum.VerticalAlignment.Top

notificationLayout.Parent =
    notificationHolder

local function notify(
    message,
    color,
    duration
)

    local notification =
        Instance.new("Frame")

    notification.Size =
        UDim2.new(
            0,
            275,
            0,
            44
        )

    notification.BackgroundColor3 =
        C.Background

    notification.BorderSizePixel = 0

    notification.BackgroundTransparency =
        1

    notification.ZIndex = 101

    notification.Parent =
        notificationHolder

    corner(
        notification,
        10
    )

    stroke(
        notification,
        color or C.Primary,
        0.25,
        1.2
    )

    local label =
        Instance.new("TextLabel")

    label.Size =
        UDim2.new(
            1,
            -20,
            1,
            0
        )

    label.Position =
        UDim2.new(
            0,
            10,
            0,
            0
        )

    label.BackgroundTransparency = 1

    label.Text =
        message

    label.Font =
        Enum.Font.GothamSemibold

    label.TextScaled = true

    label.TextColor3 =
        C.Text

    label.ZIndex = 102

    label.Parent =
        notification

    notification.Position =
        UDim2.new(
            1,
            25,
            0,
            0
        )

    tween(
        notification,
        {
            Position =
                UDim2.new(
                    0,
                    0,
                    0,
                    0
                ),
            BackgroundTransparency = 0.03
        },
        0.28
    )

    task.delay(
        duration or 2.4,
        function()

            if not notification.Parent then
                return
            end

            tween(
                notification,
                {
                    Position =
                        UDim2.new(
                            1,
                            25,
                            0,
                            0
                        ),
                    BackgroundTransparency = 1
                },
                0.25
            )

            task.wait(0.28)

            if notification.Parent then
                notification:Destroy()
            end

        end
    )
end

