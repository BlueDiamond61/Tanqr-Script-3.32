-- SETTINGS NAVIGATION
--------------------------------------------------

openSettingsBtn.Activated:Connect(function()

    if not keyAccepted then
        showKey()
        return
    end

    showSettings()

end)

backBtn.Activated:Connect(function()

    if keyAccepted then
        showMain()
    else
        showKey()
    end

end)

--------------------------------------------------
-- ANTI-FLING
--------------------------------------------------

antiFlingBtn.Activated:Connect(function()

    antiFling = not antiFling

    antiFlingBtn.Text =
        "Anti-Fling: " ..
        (antiFling and "ON" or "OFF")

end)

--------------------------------------------------
-- SOFT LIMIT
--------------------------------------------------

softLimitBtn.Activated:Connect(function()

    softLimit = not softLimit

    softLimitBtn.Text =
        "Soft Limit: " ..
        (softLimit and "ON" or "OFF")

end)

--------------------------------------------------
-- RESET SETTINGS
--------------------------------------------------

resetBtn.Activated:Connect(function()

    currentTargetSpeed = DEFAULT_SPEED

    if humanoid then
        humanoid.WalkSpeed = DEFAULT_SPEED
    end

    speedInput.Text = tostring(DEFAULT_SPEED)

    setStatus(
        "WalkSpeed reset.",
        Color3.fromRGB(180, 255, 190)
    )

end)

--------------------------------------------------
-- WALK SPEED LOOP
--------------------------------------------------

RunService.Heartbeat:Connect(function(dt)

    if not keyAccepted then
        return
    end

    if not humanoid then
        return
    end

    if humanoid.Health <= 0 then
        return
    end

    --------------------------------------------------
    -- SMOOTH SPEED
    --------------------------------------------------

    local currentSpeed = humanoid.WalkSpeed

    local difference =
        currentTargetSpeed - currentSpeed

    local step =
        difference *
        math.clamp(
            dt * smoothingFactor,
            0,
            1
        )

    humanoid.WalkSpeed =
        currentSpeed + step

    --------------------------------------------------
    -- ANTI-FLING
    --------------------------------------------------

    if antiFling then

        local character = player.Character

        if character then

            local root =
                character:FindFirstChild("HumanoidRootPart")

            if root then

                local velocity =
                    root.AssemblyLinearVelocity

                if velocity.Magnitude > 200 then

                    humanoid.WalkSpeed =
                        math.min(
                            humanoid.WalkSpeed,
                            DEFAULT_SPEED
                        )
                end
            end
        end
    end

    --------------------------------------------------
    -- UPDATE DISPLAY
    --------------------------------------------------

    currentSpeedLabel.Text =
        string.format(
            "Current: %.1f   •   Target: %.1f",
            humanoid.WalkSpeed,
            currentTargetSpeed
        )

end)

--------------------------------------------------
-- INITIAL STATE
--------------------------------------------------

keyFrame.Visible = true
mainFrame.Visible = false
settingsFrame.Visible = false

speedInput.Text = tostring(DEFAULT_SPEED)

toggleBtn.Visible = true

print("Cute WalkSpeed GUI loaded.")
