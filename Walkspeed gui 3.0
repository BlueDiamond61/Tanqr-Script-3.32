--------------------------------------------------
-- KEY ANIMATION
--------------------------------------------------

local function animateKeyEntrance()

    keyHolder.Visible = true

    keyHolder.Position =
        UDim2.new(
            0.5,
            -PANEL_WIDTH / 2,
            0.5,
            -112
        )

    keyFrame.BackgroundTransparency =
        1

    keyIcon.BackgroundTransparency =
        1

    keyTitle.TextTransparency =
        1

    keySubtitle.TextTransparency =
        1

    keyBox.BackgroundTransparency =
        1

    unlockButton.BackgroundTransparency =
        1

    keyStatus.TextTransparency =
        1

    tween(
        keyHolder,
        {
            Position =
                UDim2.new(
                    0.5,
                    -PANEL_WIDTH / 2,
                    0.5,
                    -122
                )
        },
        0.4,
        Enum.EasingStyle.Back
    )

    tween(
        keyFrame,
        {
            BackgroundTransparency = 0
        },
        0.3
    )

    task.delay(
        0.08,
        function()

            tween(
                keyIcon,
                {
                    BackgroundTransparency = 0
                },
                0.25
            )

            tween(
                keyTitle,
                {
                    TextTransparency = 0
                },
                0.25
            )

        end
    )

    task.delay(
        0.15,
        function()

            tween(
                keySubtitle,
                {
                    TextTransparency = 0
                },
                0.25
            )

            tween(
                keyBox,
                {
                    BackgroundTransparency = 0
                },
                0.25
            )

        end
    )

    task.delay(
        0.22,
        function()

            tween(
                unlockButton,
                {
                    BackgroundTransparency = 0
                },
                0.25
            )

        end
    )

    task.delay(
        0.28,
        function()

            tween(
                keyStatus,
                {
                    TextTransparency = 0
                },
                0.25
            )

        end
    )
end

