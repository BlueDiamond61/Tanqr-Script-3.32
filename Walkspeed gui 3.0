--------------------------------------------------
-- SLIDER FUNCTION
--------------------------------------------------

local draggingSlider = false

local function setSliderSpeed(speed)

    speed =
        math.clamp(
            speed,
            MIN_SPEED,
            MAX_SPEED
        )

    currentTargetSpeed = speed

    speedInput.Text =
        tostring(
            math.floor(speed * 10) / 10
        )

    local percentage =
        speed / MAX_SPEED

    sliderFill.Size =
        UDim2.new(
            percentage,
            0,
            1,
            0
        )

    sliderButton.Position =
        UDim2.new(
            percentage,
            0,
            0.5,
            0
        )

    selectedPreset = "Custom"
end

local function updateSliderFromInput(input)

    local absoluteX =
        input.Position.X

    local startX =
        sliderBack.AbsolutePosition.X

    local width =
        sliderBack.AbsoluteSize.X

    local percentage =
        math.clamp(
            (absoluteX - startX) / width,
            0,
            1
        )

    local speed =
        MIN_SPEED +
        ((MAX_SPEED - MIN_SPEED) * percentage)

    setSliderSpeed(speed)
end

connect(
    sliderButton.InputBegan,
    function(input)

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or
            input.UserInputType ==
            Enum.UserInputType.Touch
        then

            draggingSlider = true

        end
    end
)

connect(
    UserInputService.InputChanged,
    function(input)

        if not draggingSlider then
            return
        end

        if input.UserInputType ==
            Enum.UserInputType.MouseMovement
            or
            input.UserInputType ==
            Enum.UserInputType.Touch
        then

            updateSliderFromInput(input)

        end
    end
)

connect(
    UserInputService.InputEnded,
    function(input)

        if input.UserInputType ==
            Enum.UserInputType.MouseButton1
            or
            input.UserInputType ==
            Enum.UserInputType.Touch
        then

            draggingSlider = false

        end
    end
)

