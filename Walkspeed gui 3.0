--------------------------------------------------
-- STATUS FUNCTIONS
--------------------------------------------------

local function updateDisplay()

    local current = 0

    if humanoid then
        current = humanoid.WalkSpeed
    end

    speedDisplay.Text =
        string.format(
            "%.1f  →  %.1f",
            current,
            currentTargetSpeed
        )
end

local function setStatus(text, color)

    statusLabel.Text =
        "●  " .. text

    statusLabel.TextColor3 =
        color or COLORS.Success
end

--------------------------------------------------
-- PANEL TRANSITIONS
--------------------------------------------------

local function showPanel(panel)

    keyFrame.Visible = false
    mainFrame.Visible = false
    settingsFrame.Visible = false

    panel.Visible = true

    local scale =
        panel:FindFirstChildOfClass("UIScale")

    if scale then
        scale.Scale = 0.96

        tween(
            scale,
            {
                Scale = 1
            },
            0.22
        )
    end
end

local function showKey()

    guiOpen = true

    keyFrame.Visible = true
    mainFrame.Visible = false
    settingsFrame.Visible = false

end

local function showMain()

    guiOpen = true

    if not unlocked then
        showKey()
        return
    end

    keyFrame.Visible = false
    mainFrame.Visible = true
    settingsFrame.Visible = false

    updateDisplay()
end

local function showSettings()

    if not unlocked then
        showKey()
        return
    end

    guiOpen = true

    keyFrame.Visible = false
    mainFrame.Visible = false
    settingsFrame.Visible = true
end

local function closePanels()

    keyFrame.Visible = false
    mainFrame.Visible = false
    settingsFrame.Visible = false
end

--------------------------------------------------
-- KEY SYSTEM
--------------------------------------------------

local function unlock()

    local entered =
        keyBox.Text

    if entered == KEY then

        unlocked = true

        keyStatus.Text =
            "✓ Access granted"

        keyStatus.TextColor3 =
            COLORS.Success

        notify(
            "WalkSpeed unlocked!",
            COLORS.Success
        )

        task.delay(
            0.35,
            function()

                if unlocked then
                    showMain()
                end

            end
        )

    else

        keyStatus.Text =
            "× Incorrect key"

        keyStatus.TextColor3 =
            COLORS.Error

        keyBox.Text = ""

        notify(
            "Incorrect access key.",
            COLORS.Error
        )
    end
end

connect(
    unlockButton.Activated,
    unlock
)

connect(
    keyBox.FocusLost,
    function(enterPressed)

        if enterPressed then
            unlock()
        end
    end
)

--------------------------------------------------
-- SPEED INPUT
--------------------------------------------------

local function parseSpeed()

    local value =
        tonumber(speedInput.Text)

    if not value then

        notify(
            "Enter a valid number.",
            COLORS.Error
        )

        return nil
    end

    if value <= 0 then

        notify(
            "Speed must be above 0.",
            COLORS.Error
        )

        return nil
    end

    if softLimit then

        value =
            math.clamp(
                value,
                MIN_SPEED,
                MAX_SPEED
            )

    end

    return value
end

--------------------------------------------------
-- APPLY SPEED
--------------------------------------------------

local function applySpeed()

    local speed =
        parseSpeed()

    if not speed then
        return
    end

    previousTargetSpeed =
        currentTargetSpeed

    currentTargetSpeed =
        speed

    speedInput.Text =
        tostring(speed)

    setSliderSpeed(speed)

    setStatus(
        "Speed active",
        COLORS.Success
    )

    notify(
        "Target speed set to " ..
        tostring(speed),
        COLORS.Success
    )

end

connect(
    applyButton.Activated,
    applySpeed
)

connect(
    speedInput.FocusLost,
    function(enterPressed)

        if enterPressed then
            applySpeed()
        end
    end
)

--------------------------------------------------
-- PRESETS
--------------------------------------------------

local function usePreset(name, speed)

    selectedPreset = name

    currentTargetSpeed =
        speed

    speedInput.Text =
        tostring(speed)

    setSliderSpeed(speed)

    setStatus(
        name .. " preset selected",
        COLORS.Success
    )

    notify(
        name .. " preset: " ..
        tostring(speed),
        COLORS.Primary
    )
end

connect(
    normalButton.Activated,
    function()
        usePreset("Normal", 16)
    end
)

connect(
    fastButton.Activated,
    function()
        usePreset("Fast", 32)
    end
)

connect(
    veryFastButton.Activated,
    function()
        usePreset("Very Fast", 64)
    end
)

--------------------------------------------------
