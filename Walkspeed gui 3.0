--------------------------------------------------
-- STATE
--------------------------------------------------

local humanoid
local rootPart
local character

local unlocked = false
local guiOpen = true

local currentTargetSpeed = DEFAULT_SPEED
local lastTargetSpeed = DEFAULT_SPEED

local antiFling = true
local softLimit = true
local smoothSpeed = true

local invisible = false
local compactMode = false

local draggingSlider = false
local notificationBusy = false

local connections = {}

--------------------------------------------------
-- CONNECTION SYSTEM
--------------------------------------------------

local function connect(signal, callback)

    local connection = signal:Connect(callback)

    table.insert(connections, connection)

    return connection
end

--------------------------------------------------
-- CLEANUP
--------------------------------------------------

local function cleanup()

    for _, connection in ipairs(connections) do

        if connection and connection.Connected then
            connection:Disconnect()
        end

    end

    table.clear(connections)
end

--------------------------------------------------
-- CHARACTER
--------------------------------------------------

local function restoreVisibility()

    if not character then
        return
    end

    for _, object in ipairs(character:GetDescendants()) do

        if object:IsA("BasePart") then

            if object.Name ~= "HumanoidRootPart" then
                object.LocalTransparencyModifier = 0
            end

        elseif object:IsA("Decal") then

            object.Transparency = 0
        end
    end
end

local function applyVisibility()

    if not character then
        return
    end

    for _, object in ipairs(character:GetDescendants()) do

        if object:IsA("BasePart") then

            if object.Name ~= "HumanoidRootPart" then

                object.LocalTransparencyModifier =
                    invisible and 1 or 0
            end

        elseif object:IsA("Decal") then

            object.Transparency =
                invisible and 1 or 0
        end
    end
end

local function updateCharacter(newCharacter)

    character = newCharacter

    humanoid = nil
    rootPart = nil

    if not character then
        return
    end

    humanoid =
        character:WaitForChild(
            "Humanoid",
            10
        )

    rootPart =
        character:WaitForChild(
            "HumanoidRootPart",
            10
        )

    task.wait(0.2)

    if invisible then
        applyVisibility()
    else
        restoreVisibility()
    end

    if unlocked and humanoid then

        humanoid.WalkSpeed =
            currentTargetSpeed

    end
end

if player.Character then
    updateCharacter(player.Character)
end

connect(
    player.CharacterAdded,
    updateCharacter
)

--------------------------------------------------
-- GUI
--------------------------------------------------

local gui = Instance.new("ScreenGui")

gui.Name = "CuteWSGuiV3"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

gui.Parent = playerGui

--------------------------------------------------
-- UI SCALE
--------------------------------------------------

local uiScale = Instance.new("UIScale")

uiScale.Scale = 1

uiScale.Parent = gui

--------------------------------------------------
-- RESPONSIVE SCALE
--------------------------------------------------

local function updateScale()

    local camera =
        workspace.CurrentCamera

    if not camera then
        return
    end

    local viewport =
        camera.ViewportSize

    local width =
        viewport.X

    local scale = 1

    if width <= 380 then
        scale = 0.84
    elseif width <= 500 then
        scale = 0.92
    else
        scale = 1
    end

    uiScale.Scale = scale
end

updateScale()

if workspace.CurrentCamera then

    connect(
        workspace.CurrentCamera:GetPropertyChangedSignal(
            "ViewportSize"
        ),
        updateScale
    )

end

--------------------------------------------------
-- HELPERS
--------------------------------------------------

local function corner(parent, radius)

    local object =
        Instance.new("UICorner")

    object.CornerRadius =
        UDim.new(
            0,
            radius or 10
        )

    object.Parent = parent

    return object
end

local function stroke(
    parent,
    color,
    transparency,
    thickness
)

    local object =
        Instance.new("UIStroke")

    object.Color =
        color or C.Primary

    object.Transparency =
        transparency or 0.4

    object.Thickness =
        thickness or 1

    object.Parent = parent

    return object
end

local function gradient(
    parent,
    color1,
    color2,
    rotation
)

    local object =
        Instance.new("UIGradient")

    object.Color =
        ColorSequence.new({

            ColorSequenceKeypoint.new(
                0,
                color1
            ),

            ColorSequenceKeypoint.new(
                1,
                color2
            )
        })

    object.Rotation =
        rotation or 90

    object.Parent = parent

    return object
end

local function tween(
    object,
    properties,
    duration,
    style,
    direction
)

    if not object or not object.Parent then
        return
    end

    local info =
        TweenInfo.new(
            duration or 0.25,
            style or Enum.EasingStyle.Quint,
            direction or Enum.EasingDirection.Out
        )

    local animation =
        TweenService:Create(
            object,
            info,
            properties
        )

    animation:Play()

    return animation
end

--------------------------------------------------
-- PANEL SHADOW
--------------------------------------------------

local function createShadow(parent)

    local shadow =
        Instance.new("Frame")

    shadow.Name =
        "PanelShadow"

    shadow.AnchorPoint =
        Vector2.new(0.5, 0.5)

    shadow.Position =
        UDim2.new(
            0.5,
            4,
            0.5,
            7
        )

    shadow.Size =
        UDim2.new(
            1,
            8,
            1,
            8
        )

    shadow.BackgroundColor3 =
        C.Shadow

    shadow.BackgroundTransparency =
        0.48

    shadow.BorderSizePixel = 0

    shadow.ZIndex = 1

    shadow.Parent =
        parent

    corner(
        shadow,
        17
    )

    return shadow
end

--------------------------------------------------
-- PANEL
--------------------------------------------------

local function createPanel(
    name,
    width,
    height
)

    local holder =
        Instance.new("Frame")

    holder.Name =
        name .. "Holder"

    holder.Size =
        UDim2.new(
            0,
            width,
            0,
            height
        )

    holder.Position =
        UDim2.new(
            0.5,
            -width / 2,
            0.5,
            -height / 2
        )

    holder.BackgroundTransparency = 1

    holder.ZIndex = 4

    holder.Parent = gui

    local shadow =
        createShadow(holder)

    local panel =
        Instance.new("Frame")

    panel.Name =
        name

    panel.Size =
        UDim2.new(
            1,
            0,
            1,
            0
        )

    panel.Position =
        UDim2.new(
            0,
            0,
            0,
            0
        )

    panel.BackgroundColor3 =
        C.Background

    panel.BorderSizePixel = 0

    panel.ZIndex = 5

    panel.Parent =
        holder

    corner(
        panel,
        15
    )

    stroke(
        panel,
        C.PrimaryLight,
        0.3,
        1.4
    )

    gradient(
        panel,
        C.BackgroundLight,
        C.Background,
        110
    )

    return holder, panel, shadow
end

--------------------------------------------------
-- BUTTON
--------------------------------------------------

local function createButton(
    parent,
    y,
    text,
    color
)

    local button =
        Instance.new("TextButton")

    button.Size =
        UDim2.new(
            1,
            -40,
            0,
            36
        )

    button.Position =
        UDim2.new(
            0,
            20,
            0,
            y
        )

    button.BackgroundColor3 =
        color or C.Primary

    button.BorderSizePixel = 0

    button.Text =
        text

    button.Font =
        Enum.Font.GothamSemibold

    button.TextScaled = true

    button.TextColor3 =
        C.Text

    button.AutoButtonColor = false

    button.ZIndex =
        parent.ZIndex + 2

    button.Parent =
        parent

    corner(
        button,
        9
    )

    stroke(
        button,
        C.PrimaryLight,
        0.7,
        1
    )

    local originalColor =
        color or C.Primary

    local hoverColor =
        Color3.fromRGB(
            177,
            141,
            255
        )

    connect(
        button.MouseEnter,
        function()

            tween(
                button,
                {
                    BackgroundColor3 =
                        hoverColor
                },
                0.12
            )

        end
    )

    connect(
        button.MouseLeave,
        function()

            tween(
                button,
                {
                    BackgroundColor3 =
                        originalColor
                },
                0.12
            )

        end
    )

    return button
end

