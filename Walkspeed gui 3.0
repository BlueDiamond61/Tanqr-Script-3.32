--------------------------------------------------
-- GUI VISIBILITY
--------------------------------------------------

local function showKey()

    keyFrame.Visible = true
    mainFrame.Visible = false
    settingsFrame.Visible = false

end

local function showMain()

    keyFrame.Visible = false
    mainFrame.Visible = true
    settingsFrame.Visible = false

end

local function showSettings()

    keyFrame.Visible = false
    mainFrame.Visible = false
    settingsFrame.Visible = true

end

local function closeGui()

    keyFrame.Visible = false
    mainFrame.Visible = false
    settingsFrame.Visible = false

end

--------------------------------------------------
-- OPEN / CLOSE BUTTON
--------------------------------------------------

toggleBtn.Activated:Connect(function()

    guiOpen = not guiOpen

    if guiOpen then

        if keyAccepted then
            showMain()
        else
            showKey()
        end

    else

        closeGui()

    end
end)

--------------------------------------------------
-- KEY VALIDATION
--------------------------------------------------

local function unlock()

    if keyBox.Text == KEY then

        keyAccepted = true

        keyFeedback.TextColor3 =
            Color3.fromRGB(110, 255, 140)

        keyFeedback.Text = "✓ Key Accepted!"

        task.wait(0.35)

        if keyAccepted then
            showMain()
            guiOpen = true
        end

    else

        keyFeedback.TextColor3 =
            Color3.fromRGB(255, 105, 105)

        keyFeedback.Text = "× Incorrect Key"

        keyBox.Text = ""

    end
end

submitBtn.Activated:Connect(unlock)

keyBox.FocusLost:Connect(function(enterPressed)

    if enterPressed then
        unlock()
    end
end)

--------------------------------------------------
-- SPEED VALIDATION
--------------------------------------------------

local function setStatus(text, color)

    statusLabel.Text = text
    statusLabel.TextColor3 = color

end

local function applySpeed()

    local text = speedInput.Text

    if text == "" then

        setStatus(
            "Enter a speed first.",
            Color3.fromRGB(255, 170, 110)
        )

        return
    end

    local number = tonumber(text)

    if not number then

        setStatus(
            "Invalid speed.",
            Color3.fromRGB(255, 120, 120)
        )

        return
    end

    if number <= 0 then

        setStatus(
            "Speed must be above 0.",
            Color3.fromRGB(255, 120, 120)
        )

        return
    end

    if softLimit then

        number = math.clamp(
            number,
            1,
            MAX_SAFE_SPEED
        )

    end

    currentTargetSpeed = number

    speedInput.Text = tostring(number)

    setStatus(
        "Target speed: " .. tostring(number),
        Color3.fromRGB(180, 255, 190)
    )
end

--------------------------------------------------
-- MAIN BUTTONS
--------------------------------------------------

applyBtn.Activated:Connect(function()
    applySpeed()
end)

speedInput.FocusLost:Connect(function(enterPressed)

    if enterPressed then
        applySpeed()
    end
end)

removeBtn.Activated:Connect(function()

    currentTargetSpeed = DEFAULT_SPEED

    if humanoid then
        humanoid.WalkSpeed = DEFAULT_SPEED
    end

    speedInput.Text = tostring(DEFAULT_SPEED)

    setStatus(
        "WalkSpeed reset.",
        Color3.fromRGB(180, 255, 190)
    )
end)

