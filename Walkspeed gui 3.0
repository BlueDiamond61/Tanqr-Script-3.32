--------------------------------------------------
-- UNLOCK
--------------------------------------------------

local function unlock()

    if keyBox.Text == KEY then

        unlocked = true

        keyStatus.Text =
            "✓ Access granted"

        keyStatus.TextColor3 =
            C.Success

        notify(
            "Access granted!",
            C.Success
        )

        tween(
            keyIcon,
            {
                Rotation = 360
            },
            0.45,
            Enum.EasingStyle.Back
        )

        task.delay(
            0.4,
            function()

                if unlocked then
                    showMain()
                end

            end
        )

    else

        keyStatus.Text =
            "× Incorrect key"

        keyStatus.TextColor3 =
            C.Error

        keyBox.Text = ""

        tween(
            keyFrame,
            {
                Position =
                    UDim2.new(
                        0.5,
                        -PANEL_WIDTH / 2 + 7,
                        0.5,
                        -122
                    )
            },
            0.05
        )

        task.delay(
            0.05,
            function()

                tween(
                    keyFrame,
                    {
                        Position =
                            UDim2.new(
                                0.5,
                                -PANEL_WIDTH / 2 - 7,
                                0.5,
                                -122
                            )
                    },
                    0.05
                )

            end
        )

        task.delay(
            0.1,
            function()

                tween(
                    keyFrame,
                    {
                        Position =
                            UDim2.new(
                                0.5,
                                -PANEL_WIDTH / 2,
                                0.5,
                                -122
                            )
                    },
                    0.08
                )

            end
        )

        notify(
            "Incorrect key.",
            C.Error
        )
    end
end

connect(
    unlockButton.Activated,
    unlock
)

connect(
    keyBox.FocusLost,
    function(enterPressed)

        if enterPressed then
            unlock()
        end
    end
)

--------------------------------------------------
-- STATUS
--------------------------------------------------

local function setStatus(
    text,
    color
)

    statusLabel.Text =
        "●  " .. text

    statusLabel.TextColor3 =
        color or C.Success
end

--------------------------------------------------
-- ANTI FLING
--------------------------------------------------

local lastFlingTime = 0

local function antiFlingCheck()

    if not antiFling then
        return
    end

    if not rootPart or not humanoid then
        return
    end

    local velocity =
        rootPart.AssemblyLinearVelocity

    if velocity.Magnitude > 200 then

        local now =
            os.clock()

        if now - lastFlingTime > 0.3 then

            lastFlingTime =
                now

            humanoid.WalkSpeed =
                math.min(
                    humanoid.WalkSpeed,
                    DEFAULT_SPEED
                )

        end
    end
end

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

connect(
    RunService.Heartbeat,
    function(dt)

        if not unlocked then
            return
        end

        if not humanoid then
            return
        end

        if humanoid.Health <= 0 then
            return
        end

        local target =
            currentTargetSpeed

        if softLimit then

            target =
                math.clamp(
                    target,
                    MIN_SPEED,
                    MAX_SPEED
                )

        end

        if smoothSpeed then

            local current =
                humanoid.WalkSpeed

            local difference =
                target - current

            local alpha =
                math.clamp(
                    dt * SMOOTHING,
                    0,
                    1
                )

            humanoid.WalkSpeed =
                current +
                difference * alpha

        else

            humanoid.WalkSpeed =
                target

        end

        antiFlingCheck()

        if invisible then
            applyVisibility()
        end

        if mainHolder.Visible then

            speedDisplay.Text =
                string.format(
                    "%.1f  →  %.1f",
                    humanoid.WalkSpeed,
                    currentTargetSpeed
                )

        end
    end
)

--------------------------------------------------
-- PC SHORTCUTS
--------------------------------------------------

connect(
    UserInputService.InputBegan,
    function(input, processed)

        if processed then
            return
        end

        if input.KeyCode ==
            Enum.KeyCode.RightShift
        then

            if guiOpen then
                closeGui()
            else

                guiOpen = true

                if unlocked then
                    showMain()
                else
                    animateKeyEntrance()
                end
            end
        end

        if input.KeyCode ==
            Enum.KeyCode.Escape
        then

            if guiOpen then
                closeGui()
            end
        end

        if input.KeyCode ==
            Enum.KeyCode.Return
        then

            if not unlocked then
                unlock()
            end
        end
    end
)

--------------------------------------------------
-- INITIAL
--------------------------------------------------

keyHolder.Visible = true
mainHolder.Visible = false
settingsHolder.Visible = false

speedInput.Text =
    tostring(DEFAULT_SPEED)

setStatus(
    "Ready",
    C.Success
)

task.defer(
    function()

        animateKeyEntrance()

        task.wait(0.8)

        if keyHolder.Visible then

            notify(
                "Enter your access key.",
                C.Primary,
                2
            )

        end
    end
)

print(
    "[CuteWSGuiV3] Loaded."
)
