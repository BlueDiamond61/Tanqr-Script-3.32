--------------------------------------------------
-- VISIBILITY
--------------------------------------------------

local function setInvisible(state)

    invisible = state

    if invisible then

        applyVisibility()

        invisibilityButton.Text =
            "Invisible: ON"

        notify(
            "Invisibility enabled.",
            C.Success
        )

    else

        restoreVisibility()

        invisibilityButton.Text =
            "Invisible: OFF"

        notify(
            "Invisibility disabled.",
            C.Warning
        )
    end
end

connect(
    invisibilityButton.Activated,
    function()

        setInvisible(
            not invisible
        )

    end
)

--------------------------------------------------
-- COMPACT MODE
--------------------------------------------------

local function setCompact(state)

    compactMode = state

    if compactMode then

        uiScale.Scale =
            uiScale.Scale * 0.92

        compactButton.Text =
            "Compact Mode: ON"

        notify(
            "Compact mode enabled.",
            C.Primary
        )

    else

        updateScale()

        compactButton.Text =
            "Compact Mode: OFF"

        notify(
            "Compact mode disabled.",
            C.Primary
        )
    end
end

connect(
    compactButton.Activated,
    function()

        setCompact(
            not compactMode
        )

    end
)

--------------------------------------------------
-- RESET EVERYTHING
--------------------------------------------------

local function resetEverything()

    antiFling = true
    softLimit = true
    smoothSpeed = true

    invisible = false
    compactMode = false

    currentTargetSpeed =
        DEFAULT_SPEED

    lastTargetSpeed =
        DEFAULT_SPEED

    restoreVisibility()

    if humanoid then
        humanoid.WalkSpeed =
            DEFAULT_SPEED
    end

    antiFlingButton.Text =
        "Anti-Fling: ON"

    softLimitButton.Text =
        "Soft Limit: ON"

    smoothButton.Text =
        "Smooth Speed: ON"

    invisibilityButton.Text =
        "Invisible: OFF"

    compactButton.Text =
        "Compact Mode: OFF"

    speedInput.Text =
        tostring(DEFAULT_SPEED)

    sliderFill.Size =
        UDim2.new(
            DEFAULT_SPEED / MAX_SPEED,
            0,
            1,
            0
        )

    sliderKnob.Position =
        UDim2.new(
            DEFAULT_SPEED / MAX_SPEED,
            0,
            0.5,
            0
        )

    updateScale()

    notify(
        "Everything has been reset.",
        C.Success
    )
end

connect(
    resetAllButton.Activated,
    resetEverything
)

--------------------------------------------------
-- NAVIGATION
--------------------------------------------------

local function showOnly(holder)

    keyHolder.Visible = false
    mainHolder.Visible = false
    settingsHolder.Visible = false

    holder.Visible = true

    holder.Size =
        UDim2.new(
            0,
            PANEL_WIDTH * 0.96,
            0,
            holder.AbsoluteSize.Y
        )

    tween(
        holder,
        {
            Size =
                UDim2.new(
                    0,
                    PANEL_WIDTH,
                    0,
                    holder.AbsoluteSize.Y
                )
        },
        0.22,
        Enum.EasingStyle.Back
    )
end

local function showMain()

    if not unlocked then

        animateKeyEntrance()

        return
    end

    guiOpen = true

    showOnly(
        mainHolder
    )
end

local function showSettings()

    if not unlocked then

        animateKeyEntrance()

        return
    end

    guiOpen = true

    showOnly(
        settingsHolder
    )
end

local function closeGui()

    guiOpen = false

    keyHolder.Visible = false
    mainHolder.Visible = false
    settingsHolder.Visible = false
end

