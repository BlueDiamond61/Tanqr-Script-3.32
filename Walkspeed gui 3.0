--------------------------------------------------
-- APPLY SPEED
--------------------------------------------------

local function applySpeed()

    local value =
        tonumber(
            speedInput.Text
        )

    if not value then

        notify(
            "Enter a valid speed.",
            C.Error
        )

        return
    end

    if value <= 0 then

        notify(
            "Speed must be above 0.",
            C.Error
        )

        return
    end

    if softLimit then

        value =
            math.clamp(
                value,
                MIN_SPEED,
                MAX_SPEED
            )

    end

    lastTargetSpeed =
        currentTargetSpeed

    currentTargetSpeed =
        value

    speedInput.Text =
        tostring(value)

    setStatus(
        "Speed active",
        C.Success
    )

    notify(
        "Speed set to " ..
        tostring(value),
        C.Success
    )
end

connect(
    applyButton.Activated,
    applySpeed
)

connect(
    speedInput.FocusLost,
    function(enterPressed)

        if enterPressed then
            applySpeed()
        end
    end
)

